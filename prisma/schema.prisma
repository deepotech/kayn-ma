generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearchPostgres"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model City {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  lat       Float?
  lng       Float?
  
  businesses Business[]
  seoPages   SeoPage[]
  listings   Listing[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
}

model Category {
  id        String     @id @default(uuid())
  name      String     @unique
  slug      String     @unique
  
  businesses BusinessCategory[]
}

model Business {
  id            String   @id @default(uuid())
  name          String
  slug          String   @unique
  cityId        String
  address       String
  phone         String?
  website       String?
  lat           Float?
  lng           Float?
  
  rating        Float?   @default(0)
  reviewsCount  Int      @default(0)
  photos        String[] // Array of image URLs
  
  source             String   @default("apify")
  status             String   @default("active")
  claimed            Boolean  @default(false)
  
  // Ownership & Verification
  ownerId            String?
  verificationStatus String   @default("UNVERIFIED") // UNVERIFIED, PENDING, VERIFIED, REJECTED
  claimedAt          DateTime?
  verifiedAt         DateTime?
  verificationMethod String?  // phone, whatsapp, admin_manual
  claimPhone         String?
  claimNotes         String?
  
  // Additional agency profile details
  whatsapp           String?
  email              String?
  description        String?  @db.Text
  logo               String?
  coverPhoto         String?

  // Analytics
  views              Int      @default(0)
  whatsappClicks     Int      @default(0)
  callClicks         Int      @default(0)
  
  mixedServices      Boolean  @default(false)
  noDeposit          Boolean  @default(false)
  priceLevel         String?
  
  openingHours       Json?    // Storing structured hours
  
  city               City     @relation(fields: [cityId], references: [id])
  owner              User?    @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  reviews            Review[]
  categories         BusinessCategory[]
  vehicles           AgencyVehicle[]

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([cityId])
  @@index([slug])
  @@index([ownerId])
  @@index([verificationStatus])
  @@index([rating, reviewsCount]) // Optimized for filtering
}

model BusinessCategory {
  businessId String
  categoryId String
  
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([businessId, categoryId])
}

model Review {
  id                String   @id @default(uuid())
  businessId        String
  reviewerName      String
  reviewerPhotoUrl  String?
  rating            Int
  text              String?
  textTranslated    String?
  publishedAtText   String?
  originalLanguage  String?

  business          Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  createdAt         DateTime @default(now())

  @@index([businessId])
}

model SeoPage {
  id          String   @id @default(uuid())
  slug        String   @unique
  cityId      String
  title       String
  description String
  keywords    String[]
  h1          String
  content     String?  @db.Text
  intent      String?  // e.g., 'airport', 'luxury', 'cheap'

  city        City     @relation(fields: [cityId], references: [id])
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([slug])
  @@index([cityId, intent])
}

model Listing {
  id               String   @id @default(uuid())
  purpose          String   @default("sale") // sale, rent
  adType           String?  
  condition        String   @default("used") // new, used
  sellerType       String   @default("individual") // individual, agency
  title            String
  description      String?  @db.Text
  price            Float
  pricePeriod      String?  // day, week, month
  currency         String   @default("MAD")
  
  brandLabel       String
  brandSlug        String
  carModelLabel    String
  carModelSlug     String
  cityId           String
  bodyTypeLabel    String
  bodyTypeSlug     String
  
  year             Int
  mileage          Int      @default(0)
  fuelType         String
  transmission     String
  
  images           Json     // Array of {url, publicId}
  
  status           String   @default("approved") // approved, pending_review, rejected, paused
  visibility       String   @default("public") // public, hidden
  isReported       Boolean  @default(false)
  reportsCount     Int      @default(0)
  moderatedBy      String?
  lastModeratedAt  DateTime?
  rejectionReason  String?
  
  phone            String
  whatsapp         String?
  userId           String?
  sellerName       String?
  agencyName       String?
  isAgencyVerified Boolean  @default(false)
  isFeatured       Boolean  @default(false)
  marketPrice      Float?
  whatsappClicks   Int      @default(0)
  callClicks       Int      @default(0)
  
  publishedAt      DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  city             City     @relation(fields: [cityId], references: [id])
  favorites        Favorite[]
  reports          Report[]

  @@index([status, visibility, publishedAt(sort: Desc)])
  @@index([brandSlug, status, visibility])
  @@index([cityId, status, visibility])
  @@index([bodyTypeSlug, status, visibility])
  @@index([carModelSlug, status, visibility])
  @@index([userId, createdAt(sort: Desc)])
}

model User {
  id           String    @id @default(uuid())
  firebaseUid  String    @unique
  email        String    @unique
  displayName  String?
  role         String    @default("user") // user, moderator, admin
  isBanned     Boolean   @default(false)
  banReason    String?
  bannedUntil  DateTime?
  
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  businesses   Business[]

  @@index([firebaseUid])
  @@index([email])
}

model AuditLog {
  id          String   @id @default(uuid())
  actorId     String   // Firebase UID of the admin/moderator
  actorEmail  String?
  action      String   // e.g., 'approve_listing'
  targetType  String   // listing, user, report
  targetId    String
  meta        Json?
  
  createdAt   DateTime @default(now())

  @@index([actorId])
  @@index([targetType, targetId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
}

model Favorite {
  id         String   @id @default(uuid())
  userId     String
  listingId  String
  createdAt  DateTime @default(now())

  listing    Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
  @@index([userId])
}

model Follow {
  id          String   @id @default(uuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model Report {
  id          String   @id @default(uuid())
  listingId   String
  reporterId  String?  // Firebase UID
  reporterIp  String
  reason      String   // scam, duplicate, wrong_info, spam, illegal, other
  message     String?  @db.VarChar(500)
  status      String   @default("open") // open, resolved, dismissed
  resolvedBy  String?
  resolvedAt  DateTime?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  listing     Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([listingId, reporterId])
  @@index([reporterId, createdAt(sort: Desc)])
  @@index([reporterIp, createdAt(sort: Desc)])
}

model AgencyVehicle {
  id                  String    @id @default(uuid())
  agencyId            String
  brand               String
  brandSlug           String
  model               String
  modelSlug           String
  year                Int
  category            String    @default("economy") // economy, compact, midsize, suv, luxury, commercial
  bodyType            String    @default("sedan")
  transmission        String    @default("Manual") // Manual, Automatic
  fuel                String    @default("Diesel") // Diesel, Petrol, Hybrid, Electric
  seats               Int       @default(5)
  doors               Int       @default(4)
  luggage             Int       @default(2)
  color               String?
  description         String?   @db.Text
  images              Json      // Array of { url: string, publicId?: string }
  featuredImage       String?
  
  // Pricing tiers
  dailyPrice          Float
  weeklyPrice         Float?
  monthlyPrice        Float?
  securityDeposit     Float?
  minRentalDays       Int       @default(1)
  mileagePerDay       Int?      // e.g. 250 (km included per day)
  extraMileagePrice   Float?    // e.g. 2 (MAD/km)
  deliveryFee         Float?
  airportDeliveryFee  Float?
  priceNotes          String?
  seasonPricing       Json?     // Extensible seasonal foundation

  // Availability status
  status              String    @default("AVAILABLE") // AVAILABLE, RENTED, MAINTENANCE, HIDDEN
  lastConfirmedAt     DateTime  @default(now())

  // SEO & Analytics
  slug                String    @unique
  views               Int       @default(0)
  whatsappClicks      Int       @default(0)
  callClicks          Int       @default(0)
  order               Int       @default(0)

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  agency              Business  @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  @@index([agencyId, status])
  @@index([brandSlug, modelSlug])
  @@index([status])
}
