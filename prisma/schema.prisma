generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearchPostgres"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model City {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  lat       Float?
  lng       Float?
  
  businesses Business[]
  seoPages   SeoPage[]
  listings   Listing[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
}

model Category {
  id        String     @id @default(uuid())
  name      String     @unique
  slug      String     @unique
  
  businesses BusinessCategory[]
}

model Business {
  id            String   @id @default(uuid())
  name          String
  slug          String   @unique
  cityId        String
  address       String
  phone         String?
  website       String?
  lat           Float?
  lng           Float?
  
  rating        Float?   @default(0)
  reviewsCount  Int      @default(0)
  photos        String[] // Array of image URLs
  
  source        String   @default("apify")
  status        String   @default("active")
  claimed       Boolean  @default(false)
  
  mixedServices Boolean  @default(false)
  noDeposit     Boolean  @default(false)
  priceLevel    String?
  
  openingHours  Json?    // Storing structured hours
  
  city          City     @relation(fields: [cityId], references: [id])
  reviews       Review[]
  categories    BusinessCategory[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([cityId])
  @@index([slug])
  @@index([rating, reviewsCount]) // Optimized for filtering
}

model BusinessCategory {
  businessId String
  categoryId String
  
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([businessId, categoryId])
}

model Review {
  id                String   @id @default(uuid())
  businessId        String
  reviewerName      String
  reviewerPhotoUrl  String?
  rating            Int
  text              String?
  textTranslated    String?
  publishedAtText   String?
  originalLanguage  String?

  business          Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  createdAt         DateTime @default(now())

  @@index([businessId])
}

model SeoPage {
  id          String   @id @default(uuid())
  slug        String   @unique
  cityId      String
  title       String
  description String
  keywords    String[]
  h1          String
  content     String?  @db.Text
  intent      String?  // e.g., 'airport', 'luxury', 'cheap'

  city        City     @relation(fields: [cityId], references: [id])
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([slug])
  @@index([cityId, intent])
}

model Listing {
  id               String   @id @default(uuid())
  purpose          String   @default("sale") // sale, rent
  adType           String?  
  condition        String   @default("used") // new, used
  sellerType       String   @default("individual") // individual, agency
  title            String
  description      String?  @db.Text
  price            Float
  pricePeriod      String?  // day, week, month
  currency         String   @default("MAD")
  
  brandLabel       String
  brandSlug        String
  carModelLabel    String
  carModelSlug     String
  cityId           String
  bodyTypeLabel    String
  bodyTypeSlug     String
  
  year             Int
  mileage          Int      @default(0)
  fuelType         String
  transmission     String
  
  images           Json     // Array of {url, publicId}
  
  status           String   @default("approved") // approved, pending_review, rejected, paused
  visibility       String   @default("public") // public, hidden
  isReported       Boolean  @default(false)
  reportsCount     Int      @default(0)
  moderatedBy      String?
  lastModeratedAt  DateTime?
  rejectionReason  String?
  
  phone            String
  whatsapp         String?
  userId           String?
  sellerName       String?
  agencyName       String?
  isAgencyVerified Boolean  @default(false)
  isFeatured       Boolean  @default(false)
  marketPrice      Float?
  whatsappClicks   Int      @default(0)
  callClicks       Int      @default(0)
  
  publishedAt      DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  city             City     @relation(fields: [cityId], references: [id])
  favorites        Favorite[]
  reports          Report[]

  @@index([status, visibility, publishedAt(sort: Desc)])
  @@index([brandSlug, status, visibility])
  @@index([cityId, status, visibility])
  @@index([bodyTypeSlug, status, visibility])
  @@index([carModelSlug, status, visibility])
  @@index([userId, createdAt(sort: Desc)])
}

model User {
  id           String    @id @default(uuid())
  firebaseUid  String    @unique
  email        String    @unique
  displayName  String?
  role         String    @default("user") // user, moderator, admin
  isBanned     Boolean   @default(false)
  banReason    String?
  bannedUntil  DateTime?
  
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([firebaseUid])
  @@index([email])
}

model AuditLog {
  id          String   @id @default(uuid())
  actorId     String   // Firebase UID of the admin/moderator
  actorEmail  String?
  action      String   // e.g., 'approve_listing'
  targetType  String   // listing, user, report
  targetId    String
  meta        Json?
  
  createdAt   DateTime @default(now())

  @@index([actorId])
  @@index([targetType, targetId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
}

model Favorite {
  id         String   @id @default(uuid())
  userId     String
  listingId  String
  createdAt  DateTime @default(now())

  listing    Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
  @@index([userId])
}

model Follow {
  id          String   @id @default(uuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model Report {
  id          String   @id @default(uuid())
  listingId   String
  reporterId  String?  // Firebase UID
  reporterIp  String
  reason      String   // scam, duplicate, wrong_info, spam, illegal, other
  message     String?  @db.VarChar(500)
  status      String   @default("open") // open, resolved, dismissed
  resolvedBy  String?
  resolvedAt  DateTime?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  listing     Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([listingId, reporterId])
  @@index([reporterId, createdAt(sort: Desc)])
  @@index([reporterIp, createdAt(sort: Desc)])
}
